{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "if [ -e ../.git ]; then cd .. && frontend/node_modules/.bin/husky frontend/.husky; fi",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm format:check && pnpm lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --ignore-pattern src/routeTree.gen.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.46",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint --ignore-pattern src/routeTree.gen.ts"
    ],
    "*.{json,jsonc,css,scss,html,md,mdx,yml,yaml}": "oxfmt --write"
  },
  "packageManager": "pnpm@10.18.2"
}
