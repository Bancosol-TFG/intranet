Table users {
  id integer [pk, increment]
  first_name varchar(255) [not null]
  surname varchar(255)
  phone_number varchar(50)
  email varchar(255) [not null]
  password varchar(255) [not null]
  must_change_password boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    email [unique, name: 'uq_users_email', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table roles {
  id integer [pk, increment]
  name varchar(255) [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_roles_name', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table permissions {
  id integer [pk, increment]

  name varchar(255) [not null]
  description text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_permissions_name', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table user_roles {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  role_id integer [not null, ref: > roles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (user_id, role_id) [unique, name: 'uq_user_roles_user_id_role_id', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table role_permissions {
  id integer [pk, increment]
  role_id integer [not null, ref: > roles.id]
  permission_id integer [not null, ref: > permissions.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (role_id, permission_id) [unique, name: 'uq_role_permissions_role_id_permission_id', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table role_permission_catalog_state {
  id integer [pk, note: 'Tabla singleton; id fijo en 1']
  initialized boolean [not null]

  checks {
    `id = 1` [name: 'ck_role_permission_catalog_state_singleton']
  }
}

Table refresh_tokens {
  id integer [pk, increment]
  session_id uuid [not null]
  user_id integer [not null, ref: > users.id]
  token_hash varchar(64) [not null, unique, name: 'uq_refresh_tokens_token_hash']
  client varchar(20) [not null, note: 'WEB o MOBILE']
  expires_at timestamptz
  used_at timestamptz
  revoked_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  checks {
    `client IN ('WEB', 'MOBILE')` [name: 'ck_refresh_tokens_client']
  }

  indexes {
    session_id [name: 'idx_refresh_tokens_session_id']
    user_id [name: 'idx_refresh_tokens_user_id']
  }
}

Table collaborators {
  id integer [pk, increment]
  name text [not null]
  address text [not null]
  locality_id integer [not null, ref: > localities.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    locality_id [name: 'idx_collaborators_locality_id', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table collaborator_roles {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  collaborator_participation_id int [not null, ref: > collaborator_participations.id]
  role_id int [not null, ref: > roles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table contacts {
  id integer [pk, increment]
  collaborator_id integer [not null, ref: > collaborators.id]
  name text [not null]
  email text
  phone_number text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    collaborator_id [name: 'idx_contacts_collaborator_id', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table localities {
  id integer [pk, increment]
  name text [not null]
  postal_code text [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table collaborator_participations {
  id int [pk, increment]
  collaborator_id int [not null, ref: > collaborators.id]
  campaign_id int [not null, ref: > campaigns.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table campaign_types {
  id integer [pk, increment]
  name varchar [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_campaign_types_name', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table campaigns {
  id integer [pk, increment]
  campaign_type_id integer [not null, ref: > campaign_types.id]
  name varchar [not null]
  start_date date [not null, note: 'start_date <= end_date']
  end_date date [not null, note: 'start_date <= end_date']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    campaign_type_id [name: 'idx_campaigns_campaign_type_id']
  }

  checks {
    `start_date <= end_date` [name: 'ck_campaigns_dates']
  }
}

Table report_types {
  id int [pk, increment]
  name string [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table reports {
  id int [pk, increment]
  creation_date date [not null]
  resolution_date date [not null]
  description string [not null]
  solution string

  solved_by int [ref: > users.id]
  reported_by int [not null, ref: > users.id]
  campaign_id int [ref: > campaigns.id]
  report_type_id int [not null, ref: > report_types.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table store_roles {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  store_participation_id int [not null, ref: > store_participations.id]
  role_id int [not null, ref: > roles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table stores {
  id integer [pk, increment]
  locality_id integer [not null, ref: > localities.id]
  chain_id integer [not null, ref: > chains.id]
  name varchar [not null, note: 'Único entre tiendas no borradas']
  address varchar [not null]
  checkout_shelfs integer [not null]
  zone_id integer [ref: < zones.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_stores_name', note: 'Parcial: WHERE deleted_at IS NULL']
    chain_id [name: 'idx_stores_chain_id']
  }

  checks {
    `checkout_shelfs >= 0` [name: 'ck_stores_checkout_shelfs_non_negative']
  }
}

Table chains {
  id integer [pk, increment]
  code varchar [not null, note: 'Único entre cadenas no borradas']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    code [unique, name: 'uq_chains_code', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table store_participations {
  id int [pk, increment]
  store_id int [not null, ref: > stores.id]
  campaign_id int [not null, ref: > campaigns.id]
  participates bool [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (store_id, campaign_id) [unique]
  }
}

Table schedules {
  id integer [pk, increment]
  store_id integer [not null, ref: > stores.id]
  week_day integer [not null, note: 'ISO: 1 (lunes) a 7 (domingo)']
  opening_time time [not null]
  closing_time time [not null, note: 'Posterior a opening_time']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (store_id, week_day) [name: 'idx_schedules_store_id_week_day']
  }

  checks {
    `week_day BETWEEN 1 AND 7` [name: 'ck_schedules_week_day']
    `closing_time > opening_time` [name: 'ck_schedules_closing_after_opening']
  }
}

Table schedule_exceptions {
  id integer [pk, increment]
  store_id integer [not null, ref: > stores.id]
  date date [not null]
  opening_time time [note: 'Nula solo si closed; obligatoria si está abierta']
  closing_time time [note: 'Nula solo si closed; si está abierta, obligatoria y posterior a opening_time']
  closed boolean [not null, default: false, note: 'Cerrada sin horas o abierta con ambas horas; sustituye el horario semanal de la fecha']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (store_id, date) [name: 'idx_schedule_exceptions_store_id_date']
  }

  checks {
    `((closed AND opening_time IS NULL AND closing_time IS NULL) OR (NOT closed AND opening_time IS NOT NULL AND closing_time IS NOT NULL AND closing_time > opening_time))` [name: 'ck_schedule_exceptions_closed_or_slot']
  }
}

Table shifts {
  id int [pk, increment]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  notes string

  store_participation_id int [not null, ref: > store_participations.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table volunteer_participations {
  id int [pk, increment]

  collaborator_participation_id int [not null, ref: > collaborator_participations.id]
  user_id int [not null, ref: > users.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (user_id, collaborator_participation_id) [unique]
  }
}

Table shift_assignments {
  id int [pk, increment]
  shift_id int [not null, ref: > shifts.id]
  volunteer_participation_id int [not null, ref: > volunteer_participations.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (shift_id, volunteer_participation_id) [unique]
  }
}

Table zones {
  id integer [pk, increment]
  name text [not null]
  code text [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_zones_name']
  }
}

Table zone_assignments {
  id int [pk, increment]
  campaign_id int [not null, ref: > campaigns.id]
  zone_id int [not null, ref: > zones.id]
  user_id int [not null, ref: > users.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (campaign_id, zone_id, user_id) [unique]
  }
}
