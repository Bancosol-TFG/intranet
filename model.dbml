Table users {
  id int [pk, increment]
  first_name string [not null]
  surname string
  phone_number string
  email string [not null]
  password string [not null]
  must_change_password boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    email [unique, name: 'uq_users_email', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table roles {
  id int [pk, increment]
  name string [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_roles_name', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table permissions {
  id int [pk, increment]

  name string [not null]
  description string

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_permissions_name', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table user_roles {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  role_id int [not null, ref: > roles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (user_id, role_id) [unique, name: 'uq_user_roles_user_id_role_id', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table role_permissions {
  id int [pk, increment]
  role_id int [not null, ref: > roles.id]
  permission_id int [not null, ref: > permissions.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (role_id, permission_id) [unique, name: 'uq_role_permissions_role_id_permission_id', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table refresh_tokens {
  id int [pk, increment]
  session_id uuid [not null]
  user_id int [not null, ref: > users.id]
  token_hash string [not null, unique, name: 'uq_refresh_tokens_token_hash']
  client string [not null, note: 'WEB o MOBILE']
  expires_at timestamptz
  used_at timestamptz
  revoked_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    session_id [name: 'idx_refresh_tokens_session_id']
    user_id [name: 'idx_refresh_tokens_user_id']
  }
}

Table collaborators {
  id int [pk, increment]
  name string [not null]
  address string [not null]
  locality_id int [not null, ref: > localities.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table collaborator_roles {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  collaborator_participation_id int [not null, ref: > collaborator_participations.id]
  role_id int [not null, ref: > roles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table contacts {
  id int [pk, increment]
  collaborator_id int [not null, ref: > collaborators.id]
  name string [not null]
  email string
  phone_number string

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table localities {
  id int [pk, increment]
  name string [not null]
  postal_code string [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table collaborator_participations {
  id int [pk, increment]
  collaborator_id int [not null, ref: > collaborators.id]
  campaign_id int [not null, ref: > campaigns.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table campaign_types {
  id int [pk, increment]
  name string [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_campaign_types_name', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table campaigns {
  id int [pk, increment]
  campaign_type_id int [not null, ref: > campaign_types.id]
  name string [not null]
  start_date date [not null, note: 'start_date <= end_date']
  end_date date [not null, note: 'start_date <= end_date']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table report_types {
  id int [pk, increment]
  name string [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table reports {
  id int [pk, increment]
  creation_date date [not null]
  resolution_date date [not null]
  description string [not null]
  solution string

  solved_by int [ref: > users.id]
  reported_by int [not null, ref: > users.id]
  campaign_id int [ref: > campaigns.id]
  report_type_id int [not null, ref: > report_types.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table store_roles {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  store_participation_id int [not null, ref: > store_participations.id]
  role_id int [not null, ref: > roles.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table stores {
  id int [pk, increment]
  locality_id int [not null, ref: > localities.id]
  chain_id int [not null, ref: > chains.id]
  name string [not null, note: 'Único entre tiendas no borradas']
  address string [not null]
  checkout_shelfs integer [not null]
  zone_id int [ref: < zones.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    name [unique, name: 'uq_stores_name', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table chains {
  id int [pk, increment]
  code string [not null, note: 'Único entre cadenas no borradas']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    code [unique, name: 'uq_chains_code', note: 'Parcial: WHERE deleted_at IS NULL']
  }
}

Table store_participations {
  id int [pk, increment]
  store_id int [not null, ref: > stores.id]
  campaign_id int [not null, ref: > campaigns.id]
  participates bool [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (store_id, campaign_id) [unique]
  }
}

Table schedules {
  id int [pk, increment]
  store_id int [not null, ref: > stores.id]
  week_day int [not null, note: 'ISO: 1 (lunes) a 7 (domingo)']
  opening_time time [not null]
  closing_time time [not null, note: 'Posterior a opening_time']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table schedule_exceptions {
  id int [pk, increment]
  store_id int [not null, ref: > stores.id]
  date date [not null]
  opening_time time [note: 'Nula solo si closed; obligatoria si está abierta']
  closing_time time [note: 'Nula solo si closed; si está abierta, obligatoria y posterior a opening_time']
  closed bool [not null, default: false, note: 'Cerrada sin horas o abierta con ambas horas; sustituye el horario semanal de la fecha']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table shifts {
  id int [pk, increment]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  notes string

  store_participation_id int [not null, ref: > store_participations.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table volunteer_participations {
  id int [pk, increment]

  collaborator_participation_id int [not null, ref: > collaborator_participations.id]
  user_id int [not null, ref: > users.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (user_id, collaborator_participation_id) [unique]
  }
}

Table shift_assignments {
  id int [pk, increment]
  shift_id int [not null, ref: > shifts.id]
  volunteer_participation_id int [not null, ref: > volunteer_participations.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (shift_id, volunteer_participation_id) [unique]
  }
}

Table zones {
  id int [pk, increment]
  name string [not null, unique]
  code string [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table zone_assignments {
  id int [pk, increment]
  campaign_id int [not null, ref: > campaigns.id]
  zone_id int [not null, ref: > zones.id]
  user_id int [not null, ref: > users.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (campaign_id, zone_id, user_id) [unique]
  }
}
